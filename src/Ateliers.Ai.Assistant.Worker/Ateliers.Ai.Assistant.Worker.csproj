<Project Sdk="Microsoft.NET.Sdk.Web">
  <Import Project="..\..\build\BrandAssets.props" />
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyTitle>Ateliers AI Assistant Worker</AssemblyTitle>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Desktop からはビルド順序・同梱だけを参照し、実行可能アセンブリをロードしない。 -->
    <ShouldBeValidatedAsExecutableReference>false</ShouldBeValidatedAsExecutableReference>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Ateliers.Ai.Assistant.Infrastructure/Ateliers.Ai.Assistant.Infrastructure.csproj" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../Ateliers.Ai.Assistant.Windows/Ateliers.Ai.Assistant.Windows.csproj" /></ItemGroup>
</Project>
