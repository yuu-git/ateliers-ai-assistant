<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Ateliers.Ai.Assistant.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Ateliers.Ai.Assistant.Desktop.ViewModels"
    xmlns:controls="using:Ateliers.Ai.Assistant.Desktop.Controls"
    Title="Ateliers AI Assistant">
    <Grid DataContext="{x:Bind ViewModel}" Loaded="Root_Loaded">
        <NavigationView x:Name="MainNavigation"
                        PaneDisplayMode="Left" OpenPaneLength="220"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False" SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="ChatNavigationItem" Content="AI チャット" Tag="Chat" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Message" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="モデル管理" Tag="Models">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Library" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="設定" Tag="Settings">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="WebNavigationItem" Content="Web 情報収集" Tag="Web">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="World" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Grid x:Name="ContentRoot">
            <Grid x:Name="ChatPanel" Padding="24" RowSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.RowSpan="5" Margin="0,0,20,0" RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Spacing="8">
                        <TextBlock Text="保存済みの会話" FontSize="18" FontWeight="SemiBold" />
                        <Button Content="会話一覧を更新" Command="{x:Bind ViewModel.RefreshConversationsCommand}" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.SavedConversationsStateText, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.65" />
                    <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.SavedConversations}"
                              SelectedItem="{Binding SelectedSavedConversation, Mode=TwoWay}"
                              IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" AutomationProperties.Name="保存済みの会話">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SavedConversationViewModel">
                                <StackPanel Spacing="4" Padding="0,6">
                                    <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" FontSize="12" Opacity="0.65" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                        <Button Content="会話を開く" Command="{x:Bind ViewModel.OpenConversationCommand}" />
                        <Button Content="削除" Command="{x:Bind ViewModel.DeleteConversationCommand}" />
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="AI チャット" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="新しい会話はメモリ上で開始します。必要な会話だけ保存できます。"
                               TextWrapping="Wrap" Opacity="0.65" />
                    <Grid ColumnSpacing="12" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{x:Bind ViewModel.Models}"
                                  SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                  PlaceholderText="モデルを選択" AutomationProperties.Name="モデル"
                                  HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" Content="一覧を更新" Command="{x:Bind ViewModel.RefreshModelsCommand}" />
                        <Button Grid.Column="2" Content="新しい会話" Command="{x:Bind ViewModel.NewConversationCommand}" />
                        <ProgressRing Grid.Column="3" Width="24" Height="24"
                                      IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="起動" Command="{x:Bind ViewModel.LoadModelCommand}" />
                        <Button Content="停止" Command="{x:Bind ViewModel.UnloadModelCommand}" />
                        <TextBlock Text="{x:Bind ViewModel.ModelStateText, Mode=OneWay}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="会話を保存" Command="{x:Bind ViewModel.SaveConversationCommand}" />
                        <TextBlock Text="{x:Bind ViewModel.ConversationStorageStatus, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Grid.Row="1" Spacing="4">
                <InfoBar Severity="Error" IsClosable="False"
                         IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                         Title="処理を完了できませんでした"
                         Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
                <InfoBar Severity="Error" IsClosable="False" Title="会話の保存・読込"
                         IsOpen="{x:Bind ViewModel.HasPersistenceError, Mode=OneWay}"
                         Message="{x:Bind ViewModel.PersistenceErrorMessage, Mode=OneWay}" />
                </StackPanel>

                <Border Grid.Row="3" Grid.Column="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="12"
                        MaxWidth="850" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="8">
                    <InfoBar x:Name="ImagePasteError" Severity="Warning" IsClosable="True" Title="画像の貼り付け" />
                    <Border x:Name="ImagePreviewPanel" Visibility="Collapsed" Padding="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Image x:Name="AttachmentPreview" Width="160" Height="100" Stretch="Uniform" AutomationProperties.Name="添付画像プレビュー" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PendingImageDescription, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button Grid.Column="2" Content="画像を削除" Command="{x:Bind ViewModel.RemoveImageCommand}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ChatInput" Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                 PlaceholderText="メッセージを入力...（Ctrl+V で画像を添付）"
                                 AutomationProperties.Name="メッセージ" AutomationProperties.AutomationId="ChatInput"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" MaxHeight="120" />
                        <Button Grid.Column="1" Content="送信" Command="{x:Bind ViewModel.SendCommand}"
                                VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" />
                        <Button Grid.Column="2" Content="中止" Command="{x:Bind ViewModel.CancelCommand}"
                                VerticalAlignment="Bottom" />
                    </Grid>
                    </StackPanel>
                </Border>
                <Grid Grid.Row="4" Grid.Column="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="Wrap"
                               FontSize="12" Opacity="0.65" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Grid.Column="1" Text="Ollama · localhost:11434" FontSize="12" Opacity="0.5" />
                </Grid>
                <controls:ChatTranscriptView x:Name="Transcript" Grid.Row="2" Grid.Column="1" ItemsSource="{x:Bind ViewModel.Messages}" />
            </Grid>
            <Grid x:Name="ModelPanel" Padding="24" RowSpacing="16" Visibility="Collapsed"
                  DataContext="{x:Bind ModelViewModel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="8">
                    <TextBlock Text="モデル管理" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="Ollama 全体のロード状態です。手動の停止は他のアプリの利用にも影響します。"
                               TextWrapping="Wrap" Opacity="0.65" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="ロード状態を更新" Command="{x:Bind ModelViewModel.RefreshCommand}" />
                        <Button Content="選択モデルを停止" Command="{x:Bind ModelViewModel.UnloadCommand}" />
                        <ProgressRing Width="24" Height="24" IsActive="{x:Bind ModelViewModel.IsBusy, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
                <InfoBar Grid.Row="1" Severity="Error" IsClosable="False"
                         IsOpen="{x:Bind ModelViewModel.HasError, Mode=OneWay}"
                         Message="{x:Bind ModelViewModel.ErrorMessage, Mode=OneWay}" />
                <TextBlock Grid.Row="2" Text="{x:Bind ModelViewModel.StateText, Mode=OneWay}" TextWrapping="Wrap" />
                <ListView Grid.Row="3" ItemsSource="{x:Bind ModelViewModel.Models}"
                          SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                          IsEnabled="{x:Bind ModelViewModel.CanOperate, Mode=OneWay}"
                          SelectionMode="Single" AutomationProperties.Name="ロード中モデル">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:LoadedModelViewModel">
                            <StackPanel Spacing="6" Padding="8">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="モデルサイズ:" /><TextBlock Text="{x:Bind Size}" />
                                    <TextBlock Text="VRAM:" /><TextBlock Text="{x:Bind Vram}" />
                                    <TextBlock Text="量子化:" /><TextBlock Text="{x:Bind Quantization}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="ロード期限:" /><TextBlock Text="{x:Bind ExpiresAt}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            <Grid x:Name="WebPanel" Visibility="Collapsed" Padding="24" RowSpacing="12" DataContext="{x:Bind WebViewModel}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Spacing="8">
                    <TextBlock Text="Web 情報収集" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="RSS / Atom 1件から公開日時の新しい10記事を手動取得します。リンク先の全文は取得しません。収集中はチャット・モデル操作と排他制御します。" TextWrapping="Wrap" />
                    <TextBox x:Name="WebFeedUrlInput" Header="フィード URL（公開 HTTP / HTTPS）" Text="{Binding FeedUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="4096" IsEnabled="{x:Bind WebViewModel.CanEdit, Mode=OneWay}" AutomationProperties.AutomationId="WebFeedUrl" />
                    <ComboBox x:Name="WebModelInput" Header="要約モデル（選択だけではロードしません）" ItemsSource="{x:Bind WebViewModel.Models}" SelectedItem="{Binding SelectedModel, Mode=TwoWay}" IsEnabled="{x:Bind WebViewModel.CanEdit, Mode=OneWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="WebSummaryModel" />
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
                    <Button Content="取得" Command="{x:Bind WebViewModel.FetchCommand}" AutomationProperties.AutomationId="WebFetch" />
                    <Button Content="中止" Command="{x:Bind WebViewModel.CancelCommand}" />
                    <Button Content="設定を保存" Command="{x:Bind WebViewModel.SaveSettingsCommand}" />
                    <Button Content="一覧を更新" Command="{x:Bind WebViewModel.RefreshCommand}" />
                    <ProgressRing IsActive="{x:Bind WebViewModel.IsRunning, Mode=OneWay}" Width="24" Height="24" />
                </StackPanel>
                <TextBlock Grid.Row="2" Text="{x:Bind WebViewModel.StateText, Mode=OneWay}" TextWrapping="Wrap" />
                <InfoBar Grid.Row="3" IsOpen="{x:Bind WebViewModel.HasError, Mode=OneWay}" Message="{x:Bind WebViewModel.ErrorMessage, Mode=OneWay}" Severity="Error" IsClosable="False" />
                <Grid Grid.Row="4" ColumnSpacing="20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="巡回履歴（最新100件）" FontSize="20" />
                        <ListView x:Name="WebRunList" Grid.Row="1" ItemsSource="{x:Bind WebViewModel.Runs}" SelectionMode="None" AutomationProperties.AutomationId="WebRuns">
                            <ListView.ItemTemplate><DataTemplate x:DataType="vm:WebRunViewModel"><StackPanel Spacing="6" Padding="4,8">
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" /><TextBlock Text="{x:Bind Error}" TextWrapping="Wrap" />
                            </StackPanel></DataTemplate></ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    <Grid Grid.Column="1" RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="2*" /><RowDefinition Height="Auto" /><RowDefinition Height="3*" /></Grid.RowDefinitions>
                        <TextBlock Text="通知フィード（公開日時の新しい順・最新100件）" FontSize="20" TextWrapping="Wrap" />
                        <StackPanel Grid.Row="1" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="元記事を開く" Command="{x:Bind WebViewModel.OpenSourceCommand}" />
                            <Button Content="保存 Markdown を開く" Command="{x:Bind WebViewModel.OpenMarkdownCommand}" />
                            </StackPanel>
                            <Button Content="記事をまとめて削除" Command="{x:Bind WebViewModel.DeleteArticlesCommand}" AutomationProperties.AutomationId="DeleteWebArticles" />
                        </StackPanel>
                        <ListView x:Name="WebNotificationList" Grid.Row="2" ItemsSource="{x:Bind WebViewModel.Notifications}" SelectedItem="{Binding SelectedNotification, Mode=TwoWay}" AutomationProperties.AutomationId="WebNotifications">
                            <ListView.ItemTemplate><DataTemplate x:DataType="vm:WebNotificationViewModel"><StackPanel Spacing="6" Padding="4,8">
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Detail}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel></DataTemplate></ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Grid.Row="3" Text="通知本文（一覧で通知を選択してください）" FontWeight="SemiBold" />
                        <controls:ChatTranscriptView x:Name="NotificationPreview" Grid.Row="4"
                            Document="{x:Bind WebViewModel.SelectedDocument, Mode=OneWay}" AutomationProperties.Name="通知の Markdown 本文" />
                    </Grid>
                </Grid>
            </Grid>
            <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" Padding="24" DataContext="{x:Bind SettingsViewModel}">
                <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock Text="設定" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="データ保存先" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind SettingsViewModel.DataEnvironmentText}" FontWeight="SemiBold" AutomationProperties.AutomationId="DataEnvironment" />
                    <TextBlock Text="保存先は固定です。パスは選択してコピーできます。「開く」は対象フォルダーのみ必要に応じて作成します。" TextWrapping="Wrap" />
                    <InfoBar Severity="Error" IsClosable="False" IsOpen="{x:Bind SettingsViewModel.HasError, Mode=OneWay}"
                             Message="{x:Bind SettingsViewModel.ErrorMessage, Mode=OneWay}" />
                    <TextBox Header="設定データ（Roaming）" IsReadOnly="True" Text="{x:Bind SettingsViewModel.Paths.SettingsDirectory}" />
                    <Button Content="設定フォルダーを開く" Command="{x:Bind SettingsViewModel.OpenSettingsCommand}" />
                    <TextBox Header="アプリデータ（Local）" IsReadOnly="True" Text="{x:Bind SettingsViewModel.Paths.LocalDirectory}" />
                    <Button Content="アプリデータを開く" Command="{x:Bind SettingsViewModel.OpenLocalCommand}" />
                    <TextBox Header="会話履歴 DB の格納フォルダー" IsReadOnly="True" Text="{x:Bind SettingsViewModel.Paths.DatabaseDirectory}" />
                    <Button Content="DB フォルダーを開く" Command="{x:Bind SettingsViewModel.OpenDatabaseCommand}" />
                    <TextBox Header="ログ" IsReadOnly="True" Text="{x:Bind SettingsViewModel.Paths.LogsDirectory}" />
                    <Button Content="ログフォルダーを開く" Command="{x:Bind SettingsViewModel.OpenLogsCommand}" />
                    <TextBlock Text="チャットの最終選択モデル、Web フィード URL と要約モデルを設定へ保存します。起動時は選択を復元し、自動ロード・自動収集はしません。" TextWrapping="Wrap" />
                    <Button Content="設定を再読み込み" Command="{x:Bind SettingsViewModel.ReloadCommand}" />
                </StackPanel>
            </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
