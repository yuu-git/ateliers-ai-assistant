<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\build\BrandAssets.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyTitle>Ateliers AI Assistant</AssemblyTitle>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Ateliers.Ai.Assistant.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <!-- ICommand の WinRT マーシャリングを Release trimming でも保持する。 -->
    <CsWinRTAotOptimizerEnabled>Auto</CsWinRTAotOptimizerEnabled>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ateliers.Ai.Assistant.Windows\Ateliers.Ai.Assistant.Windows.csproj" />
    <ProjectReference Include="..\Ateliers.Ai.Assistant.Application\Ateliers.Ai.Assistant.Application.csproj" />
    <ProjectReference Include="..\Ateliers.Ai.Assistant.Infrastructure\Ateliers.Ai.Assistant.Infrastructure.csproj" />
    <ProjectReference Include="..\Ateliers.Ai.Assistant.Worker\Ateliers.Ai.Assistant.Worker.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.5.0" />
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
    <Content Include="Assets\ChatTranscript\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <ItemGroup>
    <AppxManifest Remove="Package.appxmanifest;Package.Debug.appxmanifest" />
    <AppxManifest Include="Package.appxmanifest" Condition="'$(Configuration)' != 'Debug' and '$(WindowsPackageType)' != 'None'" />
    <AppxManifest Include="Package.Debug.appxmanifest" Condition="'$(Configuration)' == 'Debug' and '$(WindowsPackageType)' != 'None'" />
  </ItemGroup>
  <!-- Worker は独立プロセスだが、ビルド・MSIX・発行物には同じ構成の成果物を含める。 -->
  <Target Name="IncludeWorkerPayload" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveProjectReferences">
    <MSBuild Projects="..\Ateliers.Ai.Assistant.Worker\Ateliers.Ai.Assistant.Worker.csproj" Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);Platform=$(Platform)" RemoveProperties="RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="_WorkerEntry" />
    </MSBuild>
    <PropertyGroup><_WorkerOutputDirectory>@(_WorkerEntry->'%(RootDir)%(Directory)')</_WorkerOutputDirectory></PropertyGroup>
    <Error Condition="'$(_WorkerOutputDirectory)' == ''" Text="Worker の出力ディレクトリを解決できませんでした。" />
    <ItemGroup>
      <_WorkerPayloadFiles Include="$(_WorkerOutputDirectory)**\*" />
      <Content Include="@(_WorkerPayloadFiles)">
        <Link>Worker\%(_WorkerPayloadFiles.RecursiveDir)%(_WorkerPayloadFiles.Filename)%(_WorkerPayloadFiles.Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
    </ItemGroup>
  </Target>
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <!-- EF Core のリフレクション・Migration を保持する。Phase 2 は trimming 非対応。 -->
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">False</PublishTrimmed>
    <DefaultLanguage>ja-JP</DefaultLanguage>
  </PropertyGroup>
</Project>
