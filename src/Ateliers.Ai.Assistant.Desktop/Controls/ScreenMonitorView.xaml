<UserControl x:Class="Ateliers.Ai.Assistant.Desktop.Controls.ScreenMonitorView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:Ateliers.Ai.Assistant.Desktop.ViewModels" xmlns:local="using:Ateliers.Ai.Assistant.Desktop.Controls">
 <Grid Padding="24" RowSpacing="10" SizeChanged="LayoutChanged">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Spacing="6"><TextBlock Text="画面監視" FontSize="28" FontWeight="SemiBold"/>
   <TextBlock Text="Desktop を閉じても監視を継続します。取得・解析は全監視で一件ずつ行い、停止はこの画面かトレイから操作できます。" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding CountText}"/>
   <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="監視を追加" Command="{Binding AddCommand}"/><Button Content="全監視を停止" Command="{Binding StopAllCommand}"/><Button Content="状態・モデル一覧を更新" Command="{Binding RefreshCommand}"/></StackPanel>
  </StackPanel>
  <Grid x:Name="Panes" Grid.Row="1" ColumnSpacing="14" RowSpacing="10">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="ListColumn" Width="260"/><ColumnDefinition x:Name="DetailColumn" Width="*"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition x:Name="ListRow" Height="*"/><RowDefinition x:Name="DetailRow" Height="0"/></Grid.RowDefinitions>
   <ListView x:Name="MonitorList" ItemsSource="{Binding Monitors}" SelectedItem="{Binding Selected, Mode=TwoWay}" AutomationProperties.Name="監視一覧">
    <ListView.ItemTemplate><DataTemplate x:DataType="vm:ScreenMonitorItemViewModel"><StackPanel Spacing="5" Padding="0,8"><TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{x:Bind Summary, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListView.ItemTemplate>
   </ListView>
   <Grid x:Name="Details" Grid.Column="1" RowSpacing="8">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Spacing="4"><TextBlock Text="{Binding State}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Schedule}" TextWrapping="Wrap" FontSize="12"/><InfoBar IsOpen="{Binding HasError}" Message="{Binding Error}" Severity="Warning" IsClosable="False"/></StackPanel>
    <Expander x:Name="SettingsExpander" Grid.Row="1" Header="選択中の監視設定" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
     <ScrollViewer MaxHeight="340" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="8" Padding="0,0,8,0">
      <TextBox Header="監視名" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" IsEnabled="{Binding CanEdit}"/>
      <Button Content="対象を選択" Command="{Binding PickCommand}"/><TextBlock Text="{Binding Target}" TextWrapping="Wrap"/>
      <ComboBox Header="画像入力対応モデル" ItemsSource="{Binding Models}" SelectedItem="{Binding Model, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Stretch"/>
      <ComboBox Header="監視周期（秒）" ItemsSource="{Binding Intervals}" SelectedItem="{Binding Interval, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"/>
      <TextBox Header="コメント生成プロンプト" Text="{Binding Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="110" IsEnabled="{Binding CanEdit}"/>
      <TextBlock Text="AI 一時停止中は全監視の取得も止めます。自動ロード・アンロードは既存設定に従います。設定・対象の変更は当該監視の停止後に行ってください。" TextWrapping="Wrap" FontSize="12"/>
      <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="設定を保存" Command="{Binding SaveCommand}"/><Button Content="監視開始" Command="{Binding StartCommand}" Style="{StaticResource AccentButtonStyle}"/><Button Content="監視停止" Command="{Binding StopCommand}"/><Button Content="監視を削除" Command="{Binding DeleteCommand}"/></StackPanel>
     </StackPanel></ScrollViewer>
    </Expander>
    <Grid Grid.Row="2" RowSpacing="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="コメント：監視ごと最新200件・Worker全体の本文約1 MiBまで" FontSize="12" TextWrapping="Wrap"/>
     <local:ChatTranscriptView x:Name="Transcript" Grid.Row="1" ItemsSource="{Binding Comments}"/>
    </Grid>
   </Grid>
  </Grid>
 </Grid>
</UserControl>