<UserControl x:Class="Ateliers.Ai.Assistant.Desktop.Controls.WebMonitoringView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:Ateliers.Ai.Assistant.Desktop.ViewModels" xmlns:local="using:Ateliers.Ai.Assistant.Desktop.Controls">
 <UserControl.Resources>
  <ResourceDictionary>
  <ResourceDictionary.ThemeDictionaries>
   <ResourceDictionary x:Key="Default"><SolidColorBrush x:Key="BookmarkedIconBrush" Color="#FFD54F"/></ResourceDictionary>
   <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="BookmarkedIconBrush" Color="#946F00"/></ResourceDictionary>
   <ResourceDictionary x:Key="HighContrast"><SolidColorBrush x:Key="BookmarkedIconBrush" Color="{ThemeResource SystemColorButtonTextColor}"/></ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <CollectionViewSource x:Key="NotificationGroupsView" IsSourceGrouped="True" ItemsPath="Items"/>
  <DataTemplate x:Key="ArticleDeletionTemplate" x:DataType="vm:WebNotificationViewModel">
   <StackPanel Spacing="4" Padding="4">
    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding ListDetail}" TextWrapping="Wrap" Opacity="0.7"/>
   </StackPanel>
  </DataTemplate>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid Padding="24" RowSpacing="12" SizeChanged="LayoutSizeChanged">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Spacing="8">
   <TextBlock Text="通知・情報収集" FontSize="28" FontWeight="SemiBold"/>
   <TextBlock Text="情報源を選び、新着通知と要約を確認します。" TextWrapping="Wrap" Opacity="0.7"/>
   <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="5" ItemWidth="140" ItemHeight="40">
    <Button Content="手動巡回" Click="FetchClicked" HorizontalAlignment="Stretch" Margin="0,0,8,4"/>
    <Button Content="情報源設定" Click="ManageClicked" HorizontalAlignment="Stretch" Margin="0,0,8,4"/>
    <Button Content="一覧を更新" Command="{Binding RefreshFeedCommand}" HorizontalAlignment="Stretch" Margin="0,0,8,4"/>
    <Button Content="管理" HorizontalAlignment="Stretch" Margin="0,0,8,4"><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="表示対象の記事をまとめて削除" Command="{Binding DeleteArticlesCommand}"/></MenuFlyout></Button.Flyout></Button>
   </VariableSizedWrapGrid>
  </StackPanel>
  <StackPanel Grid.Row="1" x:Name="WorkerStatus" Spacing="4">
   <TextBlock Text="{Binding StatusSummary}" TextWrapping="Wrap"/>
   <InfoBar IsOpen="{Binding HasError}" Message="{Binding ErrorMessage}" Severity="Warning" IsClosable="False"/>
   <Expander Header="接続の詳細・復旧" HorizontalAlignment="Stretch">
    <StackPanel Spacing="8"><TextBlock Text="{Binding ConnectionText}" TextWrapping="Wrap"/><TextBlock Text="{Binding AiText}" TextWrapping="Wrap"/><Button Content="Worker を開始" Command="{Binding StartCommand}"/><Button Content="Worker・AI 設定へ" Click="SettingsClicked"/></StackPanel>
   </Expander>
  </StackPanel>
  <StackPanel Grid.Row="2" Spacing="4">
   <Grid x:Name="CompactNavigation" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <ComboBox x:Name="ViewPicker" Header="表示" SelectedIndex="{Binding FilterIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="通知の表示"><ComboBoxItem Content="すべて"/><ComboBoxItem Content="未読のみ"/><ComboBoxItem Content="ブックマークのみ"/></ComboBox>
    <ComboBox x:Name="SourcePicker" Grid.Column="1" Header="情報源" ToolTipService.ToolTip="未読件数は DB 全通知から集計します" ItemsSource="{Binding SourceChoices}" SelectedItem="{Binding SelectedFeedSource, Mode=TwoWay}" DisplayMemberPath="DisplayTitle" HorizontalAlignment="Stretch"/>
   </Grid>
   <Expander Header="{Binding FilterSummary}" HorizontalAlignment="Stretch">
   <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" ItemWidth="180" ItemHeight="72">
    <ComboBox Header="タグ条件（空欄ならすべて）" IsEditable="True" ItemsSource="{Binding TagNames}" Text="{Binding TagFilterInput, Mode=TwoWay}" Width="168"/>
    <Button Content="タグで絞り込む" Command="{Binding ApplyTagFilterCommand}" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
    <Button Content="表示条件を解除" Command="{Binding ClearNotificationFiltersCommand}" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
   </VariableSizedWrapGrid>
   </Expander>
   <TextBlock Text="{Binding SelectedFeedSource.Detail}" TextWrapping="Wrap" FontSize="12" Opacity="0.75" MaxHeight="60"/>
   <TextBlock Text="{Binding RangeText}" TextWrapping="Wrap" FontSize="12"/>
   <InfoBar IsOpen="{Binding HasError}" Message="{Binding ErrorMessage}" Severity="Error" IsClosable="False"/>
  </StackPanel>
  <Grid x:Name="ReadingLayout" Grid.Row="3" ColumnSpacing="16">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="SourcesColumn" Width="210"/><ColumnDefinition x:Name="ListColumn" Width="*"/><ColumnDefinition x:Name="DetailColumn" Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="SourcePane" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="12">
    <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="表示" FontSize="18" FontWeight="SemiBold"/>
     <ListBox x:Name="ViewList" Grid.Row="1" SelectedIndex="{Binding FilterIndex, Mode=TwoWay}" AutomationProperties.Name="通知の表示" HorizontalContentAlignment="Stretch"><ListBoxItem Content="すべて"/><ListBoxItem Content="未読のみ"/><ListBoxItem Content="ブックマークのみ"/></ListBox>
     <Border Grid.Row="2" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4"/>
     <TextBlock Grid.Row="3" Text="情報源" FontSize="18" FontWeight="SemiBold"/>
     <ListView x:Name="SourceList" Grid.Row="4" ItemsSource="{Binding SourceChoices}" SelectedItem="{Binding SelectedFeedSource, Mode=TwoWay}" AutomationProperties.AutomationId="FeedSources">
      <ListView.ItemTemplate><DataTemplate x:DataType="vm:FeedSourceChoice"><TextBlock Text="{x:Bind DisplayTitle, Mode=OneWay}" TextWrapping="Wrap" Padding="0,8"/></DataTemplate></ListView.ItemTemplate>
     </ListView>
    </Grid>
   </Border>
   <Grid x:Name="ListPane" Grid.Column="1" RowSpacing="8">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="{Binding FeedHeading}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <ComboBox x:Name="ResultTab" Grid.Row="1" SelectedIndex="0" SelectionChanged="ResultTabChanged" HorizontalAlignment="Stretch" AutomationProperties.Name="通知と巡回履歴の切り替え"><ComboBoxItem Content="通知"/><ComboBoxItem Content="巡回履歴（全体の最新100件）"/></ComboBox>
    <Grid Grid.Row="2">
     <Grid x:Name="NotificationsPane"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Text="{Binding EmptyText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <ListView x:Name="NotificationList" Grid.Row="1" SelectionMode="None" AutomationProperties.AutomationId="NotificationFeed">
       <ListView.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate x:DataType="vm:NotificationDateGroup"><TextBlock Text="{x:Bind Label, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Padding="8,12,8,4"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListView.GroupStyle>
       <ListView.ItemTemplate><DataTemplate x:DataType="vm:WebNotificationViewModel"><Grid Padding="0,4">
        <Border x:Name="CurrentArticleHighlight" Visibility="{x:Bind IsCurrent, Mode=OneWay}" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}" BorderThickness="2" CornerRadius="6" IsHitTestVisible="False"/>
        <Grid ColumnSpacing="4" Padding="4">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button x:Name="OpenArticleAction" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Click="OpenArticleClicked" AutomationProperties.Name="{x:Bind Title, Mode=OneWay}">
         <StackPanel Spacing="6" Padding="2,6">
          <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="{x:Bind ShortExcerpt, Mode=OneWay}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Opacity="0.8"/>
          <RichTextBlock FontSize="12" TextWrapping="Wrap"><Paragraph><Run Text="{x:Bind ListDetail, Mode=OneWay}"/><Run Text="{x:Bind UnreadSuffix, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontWeight="SemiBold"/></Paragraph></RichTextBlock>
         </StackPanel>
        </Button>
        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Top">
         <Button x:Name="BookmarkAction" Width="40" Height="40" Click="BookmarkClicked" IsEnabled="{Binding DataContext.CanManageNotification, ElementName=NotificationList}" ToolTipService.ToolTip="{x:Bind BookmarkActionName, Mode=OneWay}" AutomationProperties.Name="{x:Bind BookmarkActionName, Mode=OneWay}" AutomationProperties.HelpText="{x:Bind Title, Mode=OneWay}">
          <Grid><TextBlock x:Name="BookmarkGlyph" Text="{x:Bind BookmarkIcon, Mode=OneWay}"/><TextBlock x:Name="BookmarkedGlyph" Text="★" Visibility="{x:Bind Item.IsBookmarked, Mode=OneWay}" Foreground="{ThemeResource BookmarkedIconBrush}"/></Grid>
         </Button>
         <Button x:Name="DeleteArticleAction" Width="40" Height="40" Click="DeleteArticleClicked" IsEnabled="{Binding DataContext.CanDeleteArticle, ElementName=NotificationList}" ToolTipService.ToolTip="記事を削除" AutomationProperties.Name="記事を削除" AutomationProperties.HelpText="{x:Bind Title, Mode=OneWay}"><FontIcon Glyph="&#xE74D;" FontSize="16"/></Button>
        </StackPanel>
        </Grid>
       </Grid></DataTemplate></ListView.ItemTemplate>
      </ListView>
     </Grid>
     <ListView x:Name="RunList" Visibility="Collapsed" ItemsSource="{Binding VisibleRuns}" SelectionMode="None" AutomationProperties.AutomationId="CollectionHistory">
      <ListView.ItemTemplate><DataTemplate x:DataType="vm:WebRunViewModel"><StackPanel Spacing="6" Padding="6,10"><TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap"/><TextBlock Text="{x:Bind Error}" Foreground="DarkRed" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListView.ItemTemplate>
     </ListView>
    </Grid>
   </Grid>
   <Grid x:Name="DetailPane" Grid.Column="2" RowSpacing="8">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Spacing="8"><Button x:Name="BackToList" Content="通知一覧へ戻る" Click="BackClicked" Visibility="Collapsed"/><TextBlock Text="記事詳細" FontSize="20" FontWeight="SemiBold"/></StackPanel>
    <Expander x:Name="ArticleOperations" Grid.Row="1" Header="記事の操作（既読・ブックマーク・タグ）" HorizontalAlignment="Stretch">
    <StackPanel Spacing="6"><TextBlock Text="別の記事へ移る・詳細を閉じると既読になります。「未読に戻す」を指定した記事は、その閲覧を終えても未読を維持します。" TextWrapping="Wrap" FontSize="12"/>
     <StackPanel x:Name="ArticleActions" Orientation="Horizontal" Spacing="8"><Button Content="元記事を開く" Command="{Binding OpenSourceCommand}"/><Button Content="保存 Markdown を開く" Command="{Binding OpenMarkdownCommand}"/></StackPanel>
     <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" ItemWidth="145" ItemHeight="36">
      <TextBlock Text="{Binding SelectedNotification.ReadLabel}" VerticalAlignment="Center"/>
      <Button Content="未読／既読を切替" Command="{Binding ToggleReadCommand}"/>
      <Button Content="{Binding SelectedNotification.BookmarkLabel, FallbackValue=ブックマーク}" Command="{Binding ToggleSelectedBookmarkCommand}"/>
     </VariableSizedWrapGrid>
     <Expander x:Name="TagEditor" Header="手動タグ" HorizontalAlignment="Stretch">
      <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="8">
       <ItemsControl ItemsSource="{Binding SelectedNotification.TagItems}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Click="TagFilterClicked" Margin="0,0,0,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <ComboBox x:Name="TagNameInput" Header="タグを追加（既存名の選択／新規入力）" IsEditable="True" ItemsSource="{Binding TagNames}" Text="{Binding TagInput, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
       <Button x:Name="AddTagAction" Content="タグを追加" Command="{Binding AddTagCommand}"/>
       <ComboBox Header="解除するタグ" ItemsSource="{Binding SelectedNotification.TagItems}" SelectedItem="{Binding SelectedTagToRemove, Mode=TwoWay}" DisplayMemberPath="Name" HorizontalAlignment="Stretch"/>
       <Button Content="選択したタグを解除" Command="{Binding RemoveTagCommand}"/>
       <TextBlock Text="タグ名を押すと絞り込みます。タグの追加・解除で既読にはなりません。" TextWrapping="Wrap" FontSize="12"/>
       <TextBlock Text="タグは64文字以内。前後の空白は除去し、英字の大文字小文字は同じ名前として扱います。" TextWrapping="Wrap" FontSize="12"/>
      </StackPanel></ScrollViewer>
     </Expander>
    </StackPanel>
    </Expander>
    <local:ChatTranscriptView x:Name="Preview" Grid.Row="2" Document="{Binding SelectedDocument}" AutomationProperties.Name="通知の Markdown 本文"/>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
