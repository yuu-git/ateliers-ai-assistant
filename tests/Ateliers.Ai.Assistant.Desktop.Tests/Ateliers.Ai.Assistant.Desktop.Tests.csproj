<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.5.0" />
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
    <Compile Include="../../src/Ateliers.Ai.Assistant.Desktop/Presentation/*.cs" Link="Presentation/%(Filename)%(Extension)" />
    <ProjectReference Include="../../src/Ateliers.Ai.Assistant.Infrastructure/Ateliers.Ai.Assistant.Infrastructure.csproj" />
    <!-- UI 非依存の ViewModel のみを共有し、WinUI の起動なしで検証する。 -->
    <Compile Include="../../src/Ateliers.Ai.Assistant.Desktop/ViewModels/*.cs" Link="ViewModels/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
